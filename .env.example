# HuntOps configuration. Copy to `.env` (git-ignored) and fill in the values marked REQUIRED.
# Never commit .env. See docs/design/v1-architecture.md §9.1 for the full variable reference.
# Variables for features that later phases deliver are listed but commented out.

# ---------------------------------------------------------------------------
# Database (REQUIRED)
# ---------------------------------------------------------------------------
POSTGRES_DB=huntops
POSTGRES_USER=huntops
# REQUIRED. Use a long random value, e.g. `openssl rand -base64 32`.
POSTGRES_PASSWORD=

# ---------------------------------------------------------------------------
# Networking
# ---------------------------------------------------------------------------
# Host interface for published ports. Keep 127.0.0.1 when a reverse proxy runs on the same host.
HUNTOPS_BIND_ADDRESS=127.0.0.1
HUNTOPS_WEB_PORT=8080
NTFY_HOST_PORT=8081
# Public URL of the dashboard (used for links in notifications), e.g. https://huntops.example.com
HUNTOPS_PUBLIC_URL=

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
# Trace | Debug | Information | Warning | Error | Critical
LOG_LEVEL=Information
# json (default, for log shipping) | text (human-readable)
LOG_FORMAT=json

# ---------------------------------------------------------------------------
# REST API
# ---------------------------------------------------------------------------
# Serve the OpenAPI document (/openapi/v1.json) and Swagger UI (/swagger). The document is public;
# every API call still requires an API key (create one with the worker's `apikey create` command).
HUNTOPS_SWAGGER_ENABLED=true

# ---------------------------------------------------------------------------
# Worker
# ---------------------------------------------------------------------------
HUNTOPS_WORKER_ID=worker

# ---------------------------------------------------------------------------
# ntfy server (huntops-ntfy container)
# ---------------------------------------------------------------------------
NTFY_IMAGE_TAG=v2.28.0
# Public URL your phone subscribes to, e.g. https://ntfy.example.com
NTFY_PUBLIC_URL=http://localhost:8081
# Required for instant delivery to the iOS ntfy app from a self-hosted server.
NTFY_UPSTREAM_BASE_URL=https://ntfy.sh
NTFY_BEHIND_PROXY=true
NTFY_AUTH_DEFAULT_ACCESS=deny-all
TZ=UTC

# ---------------------------------------------------------------------------
# Owner account & dashboard
# ---------------------------------------------------------------------------
# Used ONCE, when no owner account exists, to create it (by the migrate container on `docker compose up`).
# HuntOps never creates default credentials: with these blank and no owner, nobody can sign in.
# Password rules: 12+ characters with upper, lower, digit and symbol. Once the owner exists these are
# ignored (they never change the password); you can remove HUNTOPS_ADMIN_PASSWORD afterwards.
HUNTOPS_ADMIN_EMAIL=
HUNTOPS_ADMIN_PASSWORD=
# Default display/reminder time zone for the owner (editable later under Settings → Preferences).
HUNTOPS_OWNER_TIMEZONE=America/Los_Angeles
# Cookie security. auto: cookies are Secure whenever the request is HTTPS (directly, or via a trusted proxy),
# so http://127.0.0.1:8080 works locally. always: HTTPS is required for every request.
# Production behind a TLS reverse proxy: HUNTOPS_COOKIE_SECURE=always and HUNTOPS_TRUST_FORWARDED_HEADERS=true.
HUNTOPS_COOKIE_SECURE=auto
# Trust X-Forwarded-For/Proto/Host from a reverse proxy in front of the stack (set true behind a proxy).
HUNTOPS_TRUST_FORWARDED_HEADERS=false
# Optional build identifier shown on the System page.
HUNTOPS_GIT_COMMIT=

# ---------------------------------------------------------------------------
# Later phases (not read yet)
# ---------------------------------------------------------------------------
# Phase 4 – ntfy client (where HuntOps publishes; internal URL). The System page already uses
# NTFY_BASE_URL (default http://huntops-ntfy) for a connectivity check.
# NTFY_ENABLED=true
# NTFY_BASE_URL=http://huntops-ntfy
# NTFY_TOPIC=huntops
# NTFY_TOKEN=
# HEALTHCHECK_PING_URL=

# Phase 7 – source fetching
# HUNTOPS_FETCH_ALLOWED_HOSTS=
# HUNTOPS_FETCH_CONTACT=
# FETCH_MAX_BYTES_HTML=5242880
# FETCH_MAX_BYTES_PDF=26214400

# Phase 8 – AI extraction
# AI_PROVIDER=gemini
# GEMINI_API_KEY=
# GEMINI_MODEL=
# AI_MAX_CALLS_PER_DAY=50
# AI_MAX_CALLS_PER_SOURCE_PER_DAY=2
# AI_MAX_MANUAL_CALLS_PER_DAY=100
# AI_MAX_INPUT_CHARS=300000
# AI_MIN_CONFIDENCE=0.6
# AI_REQUEST_TIMEOUT_SECONDS=120
